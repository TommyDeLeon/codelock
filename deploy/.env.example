# Copy to .env next to this file, fill it in, then run ./deploy.sh.
# deploy.sh refuses to start if any required value is missing or still a
# placeholder — a lock app misconfigured means either "nobody can unlock" or
# "everybody can", and neither should be found in production.

# --- where it lives --------------------------------------------------------
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
TLS_EMAIL=you@example.com
# Optional. Rendered as a mailto: on the privacy page when set.
CONTACT_EMAIL=
# Public repository. Becomes the "report a bug" link on the support page.
REPO_URL=https://github.com/TommyDeLeon/codelock

# --- secrets ---------------------------------------------------------------
# Generate each one separately:
#   openssl rand -base64 48
# They must be distinct: the API refuses to boot in production if any two match.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_UNLOCK_SECRET=

# Encrypts stored GitHub tokens. Rotating it invalidates every stored token and
# forces users to reconnect — not a routine rotation.
ENCRYPTION_KEY=

POSTGRES_PASSWORD=
POSTGRES_USER=codelock
POSTGRES_DB=codelock

# --- optional --------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

BACKUP_RETENTION_DAYS=14
JUDGE_CONCURRENCY=4

PERF_TOLERANCE=1.35
PERF_FLOOR_MS=40
PERF_BEST_OF=2

# Signing in with a provider. Blank means the button is not offered.
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://${API_DOMAIN}/v1/auth/oauth/google/callback
# GitHub reuses the credentials above, but its sign-in callback
# https://${API_DOMAIN}/v1/auth/oauth/github/callback must also be registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- hosted execution, for the no-VM path ----------------------------------
# Only for the Render + Neon + hosted-Judge0 setup in docs/FREE-HOSTING.md,
# "No VM at all". The compose stack ignores these: it points JUDGE0_URL at its
# own judge container, which needs neither a key nor a host header.
#
# Setting these sends submitted code to a third party, and makes the speed gate
# approximate rather than a measurement — timings from a shared public judge are
# not comparable to the records the gate is derived from. Read the trade-offs
# before using it for anything but a demo.
#
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_KEY=
# JUDGE0_HOST=judge0-ce.p.rapidapi.com
