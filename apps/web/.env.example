# Base URL of the CodeLock API. Public: the browser calls it directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Absolute origin of the deployed site. Open Graph image URLs are resolved
# against this; without it crawlers ignore them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown as the Contact link and on the privacy page. Left unset, no contact
# line is rendered rather than inventing an address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public repository, used for the issue link on the support page. Left unset,
# the page says no tracker has been published rather than linking nowhere.
NEXT_PUBLIC_REPO_URL=https://github.com/TommyDeLeon/codelock

# Public GitHub repository, e.g. https://github.com/you/codelock. Drives the
# build-from-source instructions and the release asset URLs on /install.
NEXT_PUBLIC_REPO_URL=

# Set to a published release tag (e.g. v0.1.0) to turn the Download buttons on
# /install into real downloads. Leave empty until a release actually exists.
NEXT_PUBLIC_RELEASE_TAG=
