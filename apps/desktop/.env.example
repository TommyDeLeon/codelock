# URL of the deployed CodeLock web app the shell renders.
CODELOCK_WEB_URL=https://app.codelock.dev

# --- Unlock verification (pick ONE) ----------------------------------------
# Preferred for distributed builds: the API's PUBLIC key. Nothing secret ships
# to users, so decompiling the app grants no ability to forge an unlock.
# Escape newlines as \n.
CODELOCK_UNLOCK_PUBLIC_KEY=

# Self-hosted single-user alternative: the same value as the API's
# JWT_UNLOCK_SECRET. Simpler, but anyone who reads this file can mint their own
# unlock token.
CODELOCK_UNLOCK_SECRET=
