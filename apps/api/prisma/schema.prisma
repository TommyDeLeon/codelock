// CodeLock database schema
// Postgres + Prisma. Run `npx prisma migrate dev` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// How far into the curriculum a problem sits.
///
/// Not the same axis as `Difficulty`, and the difference matters: an EASY
/// Tier 1 problem is still a pattern a beginner has never seen. Difficulty is
/// how hard this problem is; tier is what you must already have built.
///
/// Named rather than numeric because the interesting value is 0.5 — "implement
/// the data structure", which sits between "can you write a loop" and "can you
/// recognise a pattern", and is the tier that stops pattern-matching from
/// collapsing under an interview follow-up.
enum Tier {
  /// Foundations: loops, strings, arrays, hashmaps, I/O parsing. ~60 problems.
  /// No published interview list covers this; our audience needs it.
  TIER_0
  /// Build the structure, do not just use it. ~55 problems.
  TIER_0_5
  /// Core patterns — one canonical problem per pattern. ~150.
  TIER_1
  /// Variations: same pattern, new disguise. ~330.
  TIER_2
  /// Breadth: advanced graphs, 2-D DP, greedy, bit manipulation. ~100.
  TIER_3
}

/// Pattern family, from the canonical interview lists.
///
/// The lists themselves are facts — which patterns matter, in what order — and
/// are free to use; see docs/CORPUS-SOURCES.md. The two trailing members have
/// no upstream counterpart, because no published list starts below "you can
/// already program".
enum PatternFamily {
  ARRAYS_HASHING
  TWO_POINTERS
  SLIDING_WINDOW
  STACK
  BINARY_SEARCH
  LINKED_LIST
  TREES
  TRIES
  HEAP_PRIORITY_QUEUE
  BACKTRACKING
  GRAPHS
  ADVANCED_GRAPHS
  DP_1D
  DP_2D
  GREEDY
  INTERVALS
  MATH_GEOMETRY
  BIT_MANIPULATION
  /// Tier 0 only.
  FOUNDATIONS
  /// Tier 0.5 only — the structure itself is the subject.
  DATA_STRUCTURES
}

enum Language {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  JAVA
  CPP
  GO
}

/// Lifecycle of one "your device is locked" episode.
enum LockState {
  /// Timer is counting down; nothing is blocked yet.
  ARMED
  /// Timer hit zero. Overlay is up, problem assigned.
  LOCKED
  /// Solved. Unlock token issued.
  UNLOCKED
  /// Escape hatch used (see LockSession.escapeReason).
  BYPASSED
  /// Never completed; superseded or cleaned up by the reaper job.
  ABANDONED
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  ACCEPTED
  /// Every test passed, but slower than the performance gate. Does not unlock.
  ACCEPTED_TOO_SLOW
  WRONG_ANSWER
  COMPILE_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum Platform {
  WEB
  WINDOWS
  MACOS
  LINUX
  ANDROID
  IOS
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  /// Null for accounts created through an identity provider. Such a user has
  /// no password to verify, and the login route must never treat that as a
  /// match — see the DUMMY_HASH path in routes/auth.ts.
  passwordHash      String?
  displayName       String
  preferredLanguage Language @default(JAVASCRIPT)
  timezone          String   @default("UTC")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  progress      UserProgress?
  timerConfig   TimerConfig?
  submissions   Submission[]
  lockSessions  LockSession[]
  devices       Device[]
  unlockAudits  UnlockAudit[]
  learningEvents LearningEvent[]

  @@map("users")
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   Platform
  label      String
  pushToken  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  lockSessions LockSession[]

  @@index([userId])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Timer configuration
// ---------------------------------------------------------------------------

model TimerConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled            Boolean  @default(true)
  /// Minutes of uninterrupted use before the lock fires.
  durationMinutes    Int      @default(60)
  /// Seconds of warning shown before the overlay appears.
  graceSeconds       Int      @default(60)
  /// Bitmask, Sunday = bit 0. 127 = every day.
  activeDaysMask     Int      @default(127)
  /// Local-time window in minutes past midnight, evaluated in the user's
  /// timezone. Outside it, arming is refused. from > to wraps past midnight.
  activeFromMinute   Int      @default(0)
  activeToMinute     Int      @default(1440)
  /// Start the next countdown as soon as a lock is solved.
  ///
  /// The point of the product is that the decision to be interrupted is made
  /// once, in advance, rather than each time — and the moment right after
  /// earning your screen back is the least honest moment to ask. Only a SOLVED
  /// release re-arms: the kill switch and an abandoned session deliberately do
  /// not, or holding Escape would buy ten seconds before the next countdown and
  /// the documented escape hatch would become a trap. The active-hours window
  /// still applies, so this stops on its own at the end of the day.
  autoRearm          Boolean  @default(false)
  /// How many "skip this one" escapes per day. 0 disables the escape hatch.
  dailySkipAllowance Int      @default(1)
  updatedAt          DateTime @updatedAt

  @@map("timer_configs")
}

// ---------------------------------------------------------------------------
// Problem bank
// ---------------------------------------------------------------------------

model Problem {
  id                  String     @id @default(uuid()) @db.Uuid
  slug                String     @unique
  title               String
  difficulty          Difficulty
  promptMarkdown      String
  tags                String[]   @default([])
  /// { "JAVASCRIPT": "function solve(...) {}", ... } — per-language stubs.
  starterCode         Json
  /// Harness that reads stdin, calls the solution function, prints the result.
  /// Same shape as starterCode. Keeps test cases language-agnostic.
  driverCode          Json
  /// Runtime of the canonical optimal solution, per language, in ms:
  /// { "JAVASCRIPT": 45, "CPP": 8, ... }. Language-specific because a JVM
  /// cold start dwarfs a C++ whole-program run; one global number would make
  /// the gate unwinnable in Java and trivial in C++.
  referenceRuntimeMs  Json
  /// Fastest accepted runtime ever observed, per language. Ratchets down as
  /// users beat the reference. Same shape as referenceRuntimeMs.
  bestRuntimeMs       Json       @default("{}")
  cpuTimeLimit        Float      @default(2.0)
  /// The sandbox applies this as the container's `--memory`, and the
  /// **compiler runs inside it**. That makes this a build budget, not just a
  /// runtime one: at the old 125 MB default, `g++ -O2` on <bits/stdc++.h> and
  /// `go run` were both killed outright, so even a two-line "add two integers"
  /// program failed to compile and C++ and Go users could not solve anything.
  /// Measured on this judge: 256 MB still fails, 500 MB passes.
  memoryLimitKb       Int        @default(512000)
  /// Rolling mean of accepted solve times; the promotion rule compares against it.
  avgSolveSeconds     Int        @default(600)
  solveCount          Int        @default(0)
  attemptCount        Int        @default(0)
  /// Slug of the equivalent LeetCode problem, when there is one.
  leetcodeSlug        String?
  /// How much this problem is worth being asked, 0 upward.
  ///
  /// Editorial and external, never derived from this instance's own usage:
  /// solveCount and attemptCount measure what CodeLock happened to serve, so
  /// ranking by them would just amplify whatever it served first. Populated by
  /// scripts/fetch-popularity.ts from the public like counts of the equivalent
  /// problem, and hand-editable for problems with no external counterpart.
  ///
  /// Only a ranking signal. Selection stays random and weighted so that a
  /// low-scoring problem is still reachable — see problemSelector.
  popularity          Int        @default(0)
  /// Where the number came from, so a stale or disputed score is traceable
  /// rather than anonymous. e.g. "leetcode:likes", "manual".
  popularitySource    String?
  popularityCheckedAt DateTime?
  // --- provenance ----------------------------------------------------------
  // Non-null on every row, per rule 4 in docs/CORPUS-SOURCES.md. Attribution is
  // per *problem*, not per corpus, because a single upstream dataset can span
  // several licences — CodeContests alone carries five. A blanket credit line
  // in a README cannot express that, and would be wrong for most rows.

  /// Short source key, e.g. "codelock-authored", "mbpp", "code_contests".
  source          String @default("codelock-authored")
  /// Canonical URL for this specific problem, or for the corpus if it has none.
  sourceUrl       String @default("")
  /// SPDX identifier where one exists, e.g. "CC-BY-4.0", "MIT", "CC-BY-NC-SA-4.0".
  sourceLicense   String @default("CC0-1.0")
  /// The exact wording the licence requires. Project Euler, for instance,
  /// supplies its own sentence and it is reproduced verbatim, not paraphrased.
  attributionText String @default("")
  /// Which upstream strand this row came from, e.g. "code_contests:codeforces".
  /// Non-null because generating data/NOTICE depends on it.
  sourceRef       String @default("codelock-authored")

  // --- taxonomy ------------------------------------------------------------

  patternFamily PatternFamily @default(FOUNDATIONS)
  /// Finer-grained than the family: "prefix-sum", "monotonic-stack", "kadane".
  patternTags   String[]      @default([])
  tier          Tier          @default(TIER_1)
  /// Which entry in the signature registry generates this problem's driver and
  /// starter stubs. See src/corpus/signatures.ts. Empty means "not yet wired",
  /// and the importer refuses to activate such a row.
  signatureId   String        @default("")

  // --- editorial -----------------------------------------------------------
  // Revealed only after the session resolves, SOLVED or BYPASSED. A user who
  // fails must not leave with nothing — that is the product's purpose for this
  // audience — but revealing it early would hand over the answer under a lock.

  editorialUrl      String?
  editorialMarkdown String?
  /// Per-language worked solution, same shape as `starterCode`. Shown in the
  /// debrief, never before it. A user who fails must not leave with nothing —
  /// an editorial that explains the approach without showing working code
  /// leaves a beginner exactly where they started.
  referenceSolution Json @default("{}")

  // --- ranker (see src/services/valueRanker.ts) ----------------------------
  // Every component is stored, not just the total, so "why is this rank S?"
  // answers with the six numbers rather than a shrug.

  /// 0..1 each.
  patternTransfer    Float   @default(0)
  interviewFrequency Float   @default(0)
  lockWindowFit      Float   @default(0)
  explanationQuality Float   @default(0)
  judgeability       Float   @default(0)
  /// High only where the full answer is a single published value — Project
  /// Euler's integers. A problem with a good editorial is *not* high risk:
  /// the editorial is gated behind the solve.
  answerLookupRisk   Float   @default(0)
  /// Weighted sum of the above. Can exceed 1 or fall below 0 by construction.
  valueScore         Float   @default(0)
  /// valueScore >= threshold AND answerLookupRisk < 0.5. Stored so selection
  /// does not recompute it per draw.
  eligibleForUnlock  Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  testCases    TestCase[]
  submissions  Submission[]
  lockSessions LockSession[]

  @@index([difficulty, isActive])
  @@index([tier, isActive])
  @@index([patternFamily, tier])
  /// The selection query filters on all four at once once the curriculum gate
  /// is applied. None of the three above covers that combination, so Postgres
  /// could use only one of them and re-filter the rest.
  @@index([difficulty, isActive, tier, patternFamily])
  @@map("problems")
}

model TestCase {
  id             String  @id @default(uuid()) @db.Uuid
  problemId      String  @db.Uuid
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ordinal        Int
  stdin          String
  expectedStdout String
  /// Sample cases are shown in the UI; the rest stay hidden.
  isSample       Boolean @default(false)

  @@unique([problemId, ordinal])
  @@map("test_cases")
}

// ---------------------------------------------------------------------------
// Progression
// ---------------------------------------------------------------------------

model UserProgress {
  id                    String     @id @default(uuid()) @db.Uuid
  userId                String     @unique @db.Uuid
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentDifficulty     Difficulty @default(EASY)
  /// Consecutive *fast* solves at the current tier. Resets on promote/demote/fail.
  consecutiveFastSolves Int        @default(0)
  /// Consecutive failed or abandoned lock sessions at the current tier.
  consecutiveFailures   Int        @default(0)
  totalSolved           Int        @default(0)
  totalFailed           Int        @default(0)
  /// Exponential moving average of solve time, seconds.
  emaSolveSeconds       Int        @default(600)
  /// EMA of first-submission acceptance as fixed point, 0..1000.
  firstTryRate          Int        @default(500)
  lastPromotedAt        DateTime?
  lastDemotedAt         DateTime?
  updatedAt             DateTime   @updatedAt

  @@map("user_progress")
}

// ---------------------------------------------------------------------------
// Lock sessions + submissions
// ---------------------------------------------------------------------------

model LockSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?  @db.Uuid
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  problemId String?  @db.Uuid
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  state           LockState  @default(ARMED)
  difficulty      Difficulty @default(EASY)
  armedAt         DateTime   @default(now())
  /// Server-computed moment the overlay must appear. Clients trust this over
  /// their own clock, so suspending the device does not buy extra time.
  fireAt          DateTime
  lockedAt        DateTime?
  resolvedAt      DateTime?
  /// Set while the user has paused an ARMED countdown. Resuming shifts fireAt
  /// forward by the time spent paused, so the remaining interval is preserved
  /// exactly. Never set on a LOCKED session: a live lock cannot be paused.
  pausedAt        DateTime?
  attempts        Int        @default(0)
  /// Set when state = BYPASSED: "skip_allowance" | "admin" | "emergency".
  escapeReason    String?
  /// SHA-256 of the issued unlock token. The raw JWT is returned exactly once.
  unlockTokenHash String?

  submissions Submission[]

  @@index([userId, state])
  @@index([state, fireAt])
  /// Both are foreign keys with no dedicated index; see the note on
  /// Submission.problemId.
  @@index([problemId])
  @@index([deviceId])
  @@map("lock_sessions")
}

model Submission {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String       @db.Uuid
  problem       Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  lockSessionId String?      @db.Uuid
  lockSession   LockSession? @relation(fields: [lockSessionId], references: [id], onDelete: SetNull)

  language       Language
  sourceCode     String
  status         SubmissionStatus @default(QUEUED)
  passedCount    Int              @default(0)
  totalCount     Int              @default(0)
  /// Best-of-N worst-case runtime across the test cases, in ms.
  runtimeMs      Int?
  memoryKb       Int?
  /// The gate this submission had to beat. Stored so history stays explicable
  /// after the gate ratchets down for everyone else.
  gateMs         Int?
  /// Compiler or stderr output, truncated before storage.
  message        String?
  /// Judge0 tokens, one per test case, for audit and re-polling.
  judgeTokens    String[]         @default([])
  /// Seconds from lock start to this submission. Feeds the difficulty engine.
  elapsedSeconds Int?
  createdAt      DateTime         @default(now())


  @@index([userId, createdAt])
  @@index([lockSessionId])
  /// A foreign key with no index of its own: Postgres needs the referencing
  /// side indexed to avoid scanning this table whenever a problem row is
  /// deleted or its key updated.
  @@index([problemId])
  @@map("submissions")
}

// ---------------------------------------------------------------------------
// External integrations
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum UnlockOutcome {
  /// Solved within the speed gate; a server-signed unlock token was issued.
  SOLVED
  /// A daily skip allowance was spent.
  SKIPPED
  /// The user gave up, or the desktop kill switch fired.
  ABANDONED
  /// Never resolved by anyone; closed out by the reaper.
  REAPED
}

/// Every lock that ended, and why.
///
/// Deliberately append-only and separate from LockSession, which is mutable
/// and can be reused: a session row tells you the *current* state, this tells
/// you what happened. It is the only place that can answer "did this machine
/// ever unlock without a passing submission", which is the question worth being
/// able to answer about a lock.
///
/// Rows survive the problem being deleted (SetNull) but not the user being
/// deleted (Cascade) — an audit trail for an account that no longer exists is
/// personal data with no owner and no purpose.
model UnlockAudit {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Not a relation: the audit row must outlive the session row.
  lockSessionId String  @db.Uuid
  problemId     String? @db.Uuid

  outcome UnlockOutcome

  /// Populated for SOLVED. The submission that cleared the gate.
  submissionId  String? @db.Uuid
  /// Measured runtime of that submission, in ms.
  runtimeMs     Int?
  /// The gate it had to beat. Stored so the verdict stays explicable after the
  /// gate ratchets for everyone else.
  gateMs        Int?
  /// Seconds from the overlay appearing to this outcome.
  secondsLocked Int?
  /// "skip_allowance", "kill_switch", "user_gave_up", "stale_sweep".
  reason        String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([outcome, createdAt])
  @@map("unlock_audits")
}

// ---------------------------------------------------------------------------
// Learning log
// ---------------------------------------------------------------------------

/// What kind of step this was. Deliberately coarse: the point is a readable
/// history, not an analytics funnel, and a kind nobody ever reads back is a
/// row that costs writes and teaches nothing.
enum LearningEventKind {
  TIMER_ARMED
  LOCK_ENGAGED
  PROBLEM_SERVED
  ATTEMPT_FAILED
  ATTEMPT_PASSED
  DEBRIEF_OPENED
  LOCK_BYPASSED
  DIFFICULTY_CHANGED
}

/// One step the learner actually took.
///
/// This replaces the generated case study. A case study was a polished artefact
/// written *for someone else* - evidence to show a recruiter. What is useful to
/// the person learning is duller and more honest: what they met, how many tries
/// it took, how long they sat with it, and where they gave up. That history is
/// only worth keeping if it is written as it happens, so every row here is
/// appended at the moment of the step and never revised.
///
/// It is local, and it leaves the machine only if the owner exports it.
model LearningEvent {
  id     String            @id @default(uuid()) @db.Uuid
  userId String            @db.Uuid
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   LearningEventKind
  at     DateTime          @default(now())

  /// Denormalised on purpose: the log must stay readable after a problem is
  /// deactivated or reworded, so it keeps the slug it actually showed rather
  /// than a foreign key that resolves to today's version.
  problemSlug   String?
  problemTitle  String?
  difficulty    Difficulty?
  tier          Tier?
  patternFamily PatternFamily?
  language      Language?

  /// Which try this was, counting from one, for attempt rows.
  attempt Int?
  /// Seconds between the lock engaging and this step.
  elapsedSeconds Int?
  /// The code that was submitted, kept verbatim on attempt rows.
  ///
  /// The submission table already holds this, but a log you can hand to someone
  /// — or to a model — for feedback has to be self-contained, and it has to
  /// survive the submission being cleared. Reflection needs the wrong answer
  /// far more than the right one: what you tried at 11pm is the evidence.
  sourceCode String?
  /// The submission this row describes, when there is one.
  submissionId String? @db.Uuid

  /// Anything kind-specific and small: the failing cases with expected and
  /// actual output, the minutes armed, the difficulty move.
  detail Json?

  @@index([userId, at])
  @@index([userId, kind, at])
  @@map("learning_events")
}
