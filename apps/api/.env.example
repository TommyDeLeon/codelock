# ---------------------------------------------------------------------------
# CodeLock API environment
# Copy to .env and fill in. Never commit the filled version.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Postgres. Supabase gives you this under Project Settings -> Database.
# Use the *pooled* (pgbouncer, port 6543) URL for the app and the direct
# (port 5432) URL for migrations.
DATABASE_URL=postgresql://postgres:password@localhost:5432/codelock?schema=public

# --- Auth -------------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Signs unlock tokens. MUST differ from the access secret so a stolen access
# token can never be replayed as an unlock proof.
JWT_UNLOCK_SECRET=change-me-unlock
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,app://codelock

# --- Judge0 -----------------------------------------------------------------
# Self-hosted: http://judge0-server:2358 (leave JUDGE0_KEY empty).
# RapidAPI: https://judge0-ce.p.rapidapi.com + key + host.
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com
JUDGE0_TIMEOUT_MS=20000

# Language ids are NOT stable across Judge0 releases. Defaults match
# judge0/judge0:1.13.1 (docker-compose.yml). For the newer hosted CE on
# RapidAPI use: JAVASCRIPT=93 PYTHON=71 JAVA=91 CPP=105 GO=95.
# The API logs each mapping at boot and errors loudly on a mismatch.
JUDGE0_LANG_JAVASCRIPT=63
JUDGE0_LANG_TYPESCRIPT=74
JUDGE0_LANG_PYTHON=71
JUDGE0_LANG_JAVA=62
JUDGE0_LANG_CPP=54
JUDGE0_LANG_GO=60

# --- Difficulty engine ------------------------------------------------------
# rules  = deterministic rule engine only (default, zero cost, no network)
# hybrid = rules decide the tier, OpenAI picks which problem inside that tier
DIFFICULTY_MODE=rules
OPENAI_API_KEY=

# --- Performance gate -------------------------------------------------------
# Correctness alone does not unlock. A submission must also run within
# PERF_TOLERANCE x (best known runtime) + PERF_FLOOR_MS, measured as the
# fastest of PERF_BEST_OF runs. Raise the tolerance to make the gate kinder.
PERF_TOLERANCE=1.35
PERF_FLOOR_MS=40
PERF_BEST_OF=2

# --- Integrations -----------------------------------------------------------
# Encrypts stored OAuth tokens. openssl rand -base64 48
# Rotating this invalidates every connected account.
ENCRYPTION_KEY=change-me-encryption-key-at-least-32-chars

# GitHub OAuth app: https://github.com/settings/developers
# Callback must match exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/v1/integrations/github/callback

# Where the browser lands after connecting an account.
APP_URL=http://localhost:3000
