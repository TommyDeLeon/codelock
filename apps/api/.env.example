# Private local CodeLock. Never commit a populated .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://codelock:codelock@localhost:5433/codelock?schema=public
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_UNLOCK_SECRET=change-me-use-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,app://codelock
# Bundled Docker execution service only. No RapidAPI or AI subscriptions.
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_TIMEOUT_MS=60000
GRADE_CONCURRENCY=4
GRADE_QUEUE_DEPTH=20
PERF_TOLERANCE=1.35
PERF_FLOOR_MS=40
PERF_BEST_OF=2
# Empty for direct local access. Configure only an actual trusted proxy IP/CIDR.
TRUST_PROXY=
